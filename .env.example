# JARVIS reads no .env file of its own: the values below are optional ENVIRONMENT VARIABLES
# for the `jarvis` CLI and the tests (export them in your shell, e.g. in ~/.zshrc).
# Copy this file to .env only if your own tooling loads it: .env is ignored by git.

# Path of the `claude` CLI, if it is not in ~/.local/bin (macOS also: /opt/homebrew/bin, /usr/local/bin)
# JARVIS_CLAUDE=/opt/homebrew/bin/claude

# Show tool output while chatting from the CLI (`jarvis chat`)
# JARVIS_DEBUG=1

# Development: serve the HUD from the repo instead of the app bundle
# JARVIS_HUD_DIR=/path/to/repo/macos/HUD   (macOS only)

# Windows only: folder for state files (default %APPDATA%\JARVIS)
# JARVIS_HOME=C:\path\to\folder
